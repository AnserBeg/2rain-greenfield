  "constraints": [
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_desired_state_not_empty",
      "type": "c",
      "definition": "CHECK (octet_length(desired_state) > 0)"
    },
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_parent_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (tenant_id, parent_revision_id) REFERENCES platform.app_package_revisions(tenant_id, revision_id)"
    },
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (tenant_id, revision_id)"
    },
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_provenance_not_blank",
      "type": "c",
      "definition": "CHECK (btrim(provenance) <> ''::text)"
    },
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_revision_id_unique",
      "type": "u",
      "definition": "UNIQUE (revision_id)"
    },
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_sha256",
      "type": "c",
      "definition": "CHECK (hash_algorithm = 'sha256'::text AND content_hash ~ '^[0-9a-f]{64}$'::text)"
    },
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_tenant_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (tenant_id) REFERENCES platform.tenants(id)"
    },
    {
      "schema": "platform",
      "relation": "app_package_revisions",
      "name": "app_package_revisions_versions_not_blank",
      "type": "c",
      "definition": "CHECK (btrim(schema_version) <> ''::text AND btrim(language_version) <> ''::text AND btrim(normalization_profile_version) <> ''::text AND btrim(canonicalization_profile_version) <> ''::text)"
    },
    {
      "schema": "platform",
      "relation": "environments",
      "name": "environments_pkey",
      "type": "p",
      "definition": "PRIMARY KEY (tenant_id, id)"
    },
    {
      "schema": "platform",
      "relation": "environments",
      "name": "environments_slug_not_blank",
      "type": "c",
      "definition": "CHECK (btrim(slug) <> ''::text)"
    },
    {
      "schema": "platform",
      "relation": "environments",
      "name": "environments_tenant_id_fkey",
      "type": "f",
      "definition": "FOREIGN KEY (tenant_id) REFERENCES platform.tenants(id)"
    },
    {
      "schema": "platform",
      "relation": "environments",
      "name": "environments_tenant_slug_unique",
      "type": "u",
      "definition": "UNIQUE (tenant_id, slug)"
    },
    {
      "schema": "platform",
      "relation": "immutable_release_write_guard",
      "name": "immutable_release_write_guard_reject",
      "type": "c",
      "definition": "CHECK (false)"
    },
    {
      "schema": "platform",
      "relation": "release_artifact_blobs",
