{
  "name": "greenfield-north-star-erp",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": "22.22.2",
    "pnpm": "11.9.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "check:boundaries": "node --import tsx packages/dev-tooling/src/check-boundaries.ts",
    "check:schema": "node --import tsx test/helpers/check-schema.ts",
    "clean": "node scripts/clean.mjs",
    "db:migrate": "node --import tsx packages/postgres-provider/src/migrate.ts",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test": "corepack pnpm test:unit && corepack pnpm test:integration && corepack pnpm test:architecture && corepack pnpm test:postgres && corepack pnpm test:browser",
    "test:architecture": "node --import tsx --test test/architecture/**/*.test.ts",
    "test:unit": "node --import tsx --test test/unit/**/*.test.ts",
    "test:integration": "node --import tsx --test test/integration/**/*.test.ts",
    "test:postgres": "node --import tsx --test test/postgres/**/*.test.ts",
    "test:browser": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.15.0",
    "@types/pg": "^8.20.0",
    "eslint": "^9.34.0",
    "js-tiktoken": "1.0.21",
    "pg": "^8.22.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.42.0"
  }
}
